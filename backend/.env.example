# Template for local env — copy to .env and fill in real values.
# Committed to VCS; never put real secrets here.

# 한국투자증권 오픈API — timeline(지표 바), heatmap(단물 지도) 공용
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전투자: https://openapi.koreainvestment.com:9443
# 모의투자: https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# 히트맵 수집: 기존 KIS 키/토큰 재사용. 브라우저에서 KIS를 직접 호출하지 않음.
HEATMAP_ENABLED=true
HEATMAP_REQUESTS_PER_SECOND=5
# 특별 개장/마감시간을 KRX 공지 기준으로 지정하는 JSON. 기본은 09:00~15:30(한국 시간).
HEATMAP_SESSION_OVERRIDES={}

# FRED(미국 연준 경제 데이터) API — calendar 도메인에서 사용 예정
FRED_API_KEY=

# 네이버 검색 API(뉴스) — timeline 도메인(주요 뉴스)에서 사용
# 네이버 클라우드 플랫폼(NCP)에서 발급받은 키 — developers.naver.com 쪽 키와는 다름
# 호출: https://naverapihub.apigw.ntruss.com/search/v1/news
# 헤더: X-NCP-APIGW-API-KEY-ID(=NAVER_API_KEY_ID) / X-NCP-APIGW-API-KEY(=NAVER_API_KEY)
NAVER_API_KEY_ID=
NAVER_API_KEY=

# 제미나이 API — 브리핑·주린이 해설 생성(timeline), 일정 중요도 판단(calendar)에서 사용
GEMINI_API_KEY=

# DART(전자공시시스템) Open API — calendar 도메인, 기업 실적 발표일 조사용(테스트 단계)
DART_API_KEY=

# 한국은행 ECOS(경제통계시스템) Open API — calendar 도메인, 한국 기준금리 조사용(테스트 단계)
# 비워두면 "sample" 키로 대체 호출됨(최대 10건 제한) — ecos.bok.or.kr에서 정식 키 발급 가능
ECOS_API_KEY=

# 관리용 POST(수집·보고서 생성) 호출 키 — 아무 문자열이나 길게. 요청 헤더 X-Admin-Key로 보낸다
# 비워 두면 POST /timeline/collect/*, /timeline/report/* 는 503으로 막힌다 (GET은 영향 없음)
ADMIN_API_KEY=

# Supabase Postgres 연결 문자열 — 전체 공용, Supabase 대시보드 > Project Settings > Database > Connection string 에서 확인
# 주의: Supabase가 기본으로 주는 문자열은 "postgresql://..."로 시작함 — SQLAlchemy 비동기(asyncpg)로
# 쓰려면 앞부분을 "postgresql+asyncpg://..."로 바꿔서 넣을 것
DATABASE_URL=


# Pollinations — enter.pollinations.ai에서 발급한 sk_ 비밀 키 (서버 .env에만 둘 것), 모델 id
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=z-image-turbo

# Supabase Storage — timeline 보고서 이미지 업로드
# Project Settings > Data API > Project URL / Project Settings > API Keys > Secret key(또는 Legacy service_role)
# 서비스 키는 DB 전체 권한 — 서버 .env에만 둘 것
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 로그인 세션 쿠키 (auth 도메인). 로컬(프론트·백엔드 둘 다 localhost)은 기본값 그대로 두면 된다.
# 실제 배포(프론트·백엔드가 서로 다른 도메인)로 넘어가면 SESSION_COOKIE_SECURE=true,
# SESSION_COOKIE_SAMESITE=none으로 바꿔야 한다 - 이땐 백엔드도 HTTPS여야 브라우저가 쿠키를 허용한다
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=14

# 개미레터(뉴스레터) 본문에 넣는 사이트 링크. 로컬은 기본값 그대로 두면 된다. 배포 도메인이 생기면 채울 것
FRONTEND_URL=http://localhost:3000

# 이메일 발송(SMTP) - 아이디/비밀번호 찾기, 개미레터가 공용으로 쓴다
# Gmail 발신 전용 계정 기준: SMTP_USER는 그 계정 이메일 주소, SMTP_PASSWORD는 Gmail 앱 비밀번호
# (계정 비밀번호가 아니라 Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 발급받은 값)
# 키가 비어 있으면 실제 발송 대신 로그로만 남긴다(로컬 개발 시 SMTP 없이도 동작)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
